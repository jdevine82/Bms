# Settings for one MS/TP trunk: copy to /etc/devine-bms/mstp-<trunk>.env, for example
# /etc/devine-bms/mstp-mstp1.env for the trunk called mstp1 in the site configuration.
# The site configuration's trunk (type bacnet_mstp) must match these values.

# The RS485 adapter, by its stable name (deploy/udev/99-devine-bms-rs485.rules).
BACNET_IFACE=/dev/bms-rs485-2
BACNET_MSTP_BAUD=38400
# MAC 0 is the site server on every trunk; MAC 1 is the Pi HMI (main spec 9).
BACNET_MSTP_MAC=0
# Highest master MAC on the trunk. Lower is faster: the token is not offered above it.
BACNET_MAX_MASTER=127
BACNET_MAX_INFO_FRAMES=1

# The API address bms-backend connects to. 127.0.0.1 when the backend runs on the host;
# the host's address on the host-only bridge when it runs in an LXC container.
BMS_MSTP_LISTEN=127.0.0.1:47900
# This node's own BACnet device instance; unique on the site.
BMS_MSTP_INSTANCE=3999101
# Wait per try for a device's answer, and extra tries.
BMS_MSTP_APDU_TIMEOUT=3000
BMS_MSTP_APDU_RETRIES=1

# BACnet router (milestone 8): leave empty for no routing. To route this trunk to BACnet/IP,
# give the trunk its own address on the device-network port with a label (see README,
# "BACnet router"), then:
#   BMS_MSTP_ROUTE_ARGS=--route eth1:mstp1 --ip-net 1 --mstp-net 101
# The network numbers must match the site configuration (bacnet.networkNumber and the trunk's
# networkNumber) and be unique on the site.
BMS_MSTP_ROUTE_ARGS=
