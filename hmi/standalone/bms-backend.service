# Devine BMS backend in standalone mode (milestone 11a): the Pi is the whole system.
[Unit]
Description=Devine BMS (standalone)
Requires=bms-pgram.service
After=bms-pgram.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/devine-bms/config

[Service]
User=bms
Group=bms
WorkingDirectory=/opt/devine-bms/app/backend
EnvironmentFile=/etc/devine-bms/standalone.env
ExecStartPre=/opt/devine-bms/venv/bin/alembic upgrade head
ExecStart=/opt/devine-bms/venv/bin/uvicorn devine_bms.api.app:app --host 0.0.0.0 --port 80
# Port 80 without root: the web app is http://<pi address>/ (HTTP on the LAN, main spec 8).
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=5
# A clean stop saves the state file (memory variables) before PostgreSQL in RAM goes.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
