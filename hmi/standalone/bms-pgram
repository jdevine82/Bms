#!/bin/bash
# PostgreSQL in RAM for standalone mode (milestone 11a, decision 028). Run by bms-pgram.service at
# every boot: a fresh cluster on tmpfs, so nothing is written to the SD card. The site comes back
# from the state file when the backend starts.
set -euo pipefail
. /etc/devine-bms/standalone.env
DATA=/run/devine-bms/pg
PGBIN="$(ls -d /usr/lib/postgresql/*/bin | sort -V | tail -1)"

case "${1:-}" in
start)
    install -d -m 0755 /run/devine-bms
    mountpoint -q "$DATA" || { install -d -o postgres -g postgres -m 0700 "$DATA"; mount -t tmpfs -o size=256m,mode=0700,uid="$(id -u postgres)",gid="$(id -g postgres)" tmpfs "$DATA"; }
    if [ ! -s "$DATA/PG_VERSION" ]; then
        runuser -u postgres -- "$PGBIN/initdb" -D "$DATA" -A scram-sha-256 --pwfile=<(echo "$BMS_PG_SUPER_PASSWORD") -U postgres >/dev/null
        cat >> "$DATA/postgresql.conf" <<'CONF'
# Standalone (in RAM): small, and no durability work for data that lives in RAM anyway.
listen_addresses = 'localhost'
unix_socket_directories = '/run/devine-bms'
shared_buffers = 32MB
max_connections = 30
fsync = off
synchronous_commit = off
full_page_writes = off
logging_collector = off
CONF
    fi
    runuser -u postgres -- "$PGBIN/pg_ctl" -D "$DATA" -w -l /run/devine-bms/pg.log start >/dev/null
    PGPASSWORD="$BMS_PG_SUPER_PASSWORD" "$PGBIN/psql" -h localhost -U postgres -qtAc "SELECT 1 FROM pg_roles WHERE rolname='bms'" | grep -q 1 || \
        PGPASSWORD="$BMS_PG_SUPER_PASSWORD" "$PGBIN/psql" -h localhost -U postgres -q \
            -c "CREATE ROLE bms LOGIN PASSWORD '$BMS_PG_PASSWORD'" -c "CREATE DATABASE bms OWNER bms"
    ;;
stop)
    [ -s "$DATA/PG_VERSION" ] && runuser -u postgres -- "$PGBIN/pg_ctl" -D "$DATA" -m fast stop >/dev/null || true
    ;;
*) echo "usage: $0 start|stop" >&2; exit 2 ;;
esac
