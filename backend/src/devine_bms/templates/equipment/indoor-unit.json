{
  "id": "indoor-unit",
  "version": "1.0.0",
  "dis": "Indoor unit (Mitsubishi H5, H6)",
  "tags": {
    "fcu": true
  },
  "roles": [
    {
      "role": "room_temp",
      "dis": "Room temperature",
      "type": "sensor",
      "kind": "Number",
      "tags": {
        "zone": true,
        "air": true,
        "temp": true
      },
      "required": true,
      "pollClass": "fast",
      "unit": "°C"
    },
    {
      "role": "setpoint",
      "dis": "Set temperature",
      "type": "sp",
      "kind": "Number",
      "tags": {
        "zone": true,
        "air": true,
        "temp": true
      },
      "required": true,
      "pollClass": "normal",
      "unit": "°C",
      "writeLimits": {
        "min": 17,
        "max": 30
      }
    },
    {
      "role": "on_off_cmd",
      "dis": "On/off command",
      "type": "cmd",
      "kind": "Bool",
      "tags": {
        "run": true
      },
      "required": true,
      "pollClass": "normal",
      "occupancy": {
        "occupied": true,
        "unoccupied": false
      }
    },
    {
      "role": "on_off_state",
      "dis": "On/off state",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "run": true
      },
      "required": true,
      "pollClass": "fast"
    },
    {
      "role": "alarm",
      "dis": "Alarm",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "alarm": true
      },
      "required": true,
      "pollClass": "fast",
      "alarms": [
        {
          "type": "state",
          "level": "warning",
          "state": true,
          "delayS": 30
        }
      ]
    },
    {
      "role": "error_code",
      "dis": "Error code",
      "type": "sensor",
      "kind": "Number",
      "tags": {
        "devineErrorCode": true
      },
      "required": false,
      "pollClass": "normal"
    },
    {
      "role": "mode_cmd",
      "dis": "Mode command",
      "type": "cmd",
      "kind": "Number",
      "tags": {
        "hvacMode": true
      },
      "required": false,
      "pollClass": "normal",
      "writeLimits": {
        "min": 1,
        "max": 5
      }
    },
    {
      "role": "mode_state",
      "dis": "Mode",
      "type": "sensor",
      "kind": "Number",
      "tags": {
        "hvacMode": true
      },
      "required": false,
      "pollClass": "normal"
    },
    {
      "role": "fan_speed_cmd",
      "dis": "Fan speed command",
      "type": "cmd",
      "kind": "Number",
      "tags": {
        "fan": true,
        "speed": true
      },
      "required": false,
      "pollClass": "normal",
      "writeLimits": {
        "min": 1,
        "max": 4
      }
    },
    {
      "role": "fan_speed_state",
      "dis": "Fan speed",
      "type": "sensor",
      "kind": "Number",
      "tags": {
        "fan": true,
        "speed": true
      },
      "required": false,
      "pollClass": "normal"
    },
    {
      "role": "filter_sign",
      "dis": "Filter sign",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "filter": true,
        "alarm": true
      },
      "required": false,
      "pollClass": "slow",
      "alarms": [
        {
          "type": "state",
          "level": "info",
          "state": true,
          "delayS": 60
        }
      ]
    },
    {
      "role": "comms_state",
      "dis": "Communication state",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "devineComms": true
      },
      "required": false,
      "pollClass": "normal"
    }
  ],
  "parameters": {
    "setpointMin": 19,
    "setpointMax": 30
  },
  "notes": [
    "Mode and fan speed are state numbers until the Mitsubishi state order is checked on the bench; then they become Str roles with an enum list.",
    "Write limits: set temperature 17 to 30 °C (the widest range; narrow it per model), mode 1 to 5 and fan speed 1 to 4 (state numbers; check them on the bench)."
  ]
}
