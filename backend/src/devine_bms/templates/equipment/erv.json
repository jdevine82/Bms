{
  "id": "erv",
  "version": "1.0.0",
  "dis": "Energy recovery ventilator (including Lossnay)",
  "tags": {
    "heatExchanger": true
  },
  "roles": [
    {
      "role": "run_cmd",
      "dis": "Run command",
      "type": "cmd",
      "kind": "Bool",
      "tags": {
        "run": true
      },
      "required": true,
      "pollClass": "normal"
    },
    {
      "role": "run_state",
      "dis": "Run status",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "run": true
      },
      "required": true,
      "pollClass": "fast"
    },
    {
      "role": "alarm",
      "dis": "Alarm",
      "type": "sensor",
      "kind": "Bool",
      "tags": {
        "alarm": true
      },
      "required": false,
      "pollClass": "fast",
      "alarms": [
        {
          "type": "state",
          "level": "warning",
          "state": true,
          "delayS": 30
        }
      ]
    },
    {
      "role": "mode_state",
      "dis": "Ventilation mode",
      "type": "sensor",
      "kind": "Number",
      "tags": {
        "hvacMode": true
      },
      "required": false,
      "pollClass": "normal"
    }
  ]
}
