# Copy to backend/.env (gitignored) and fill in. Never commit .env.
BMS_DATABASE_URL=postgresql+asyncpg://bms:CHANGE_ME@localhost:5432/bms
BMS_CONFIG_PATH=../config/site.json
BMS_LOG_LEVEL=INFO
# Development machines without TimescaleDB only. Sites must never set this.
# BMS_ALLOW_PLAIN_POSTGRES=true
# For the database tests: an empty database the tests may wipe.
# BMS_TEST_DATABASE_URL=postgresql+asyncpg://bms:CHANGE_ME@localhost:5432/bms_test
