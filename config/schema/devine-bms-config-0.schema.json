  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "devine-bms-config/0",
      "title": "Schema",
      "type": "string"
    },
    "site": {
      "$ref": "#/$defs/Site"
    },
    "spaces": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Space"
      },
      "title": "Spaces",
      "type": "array"
    },
    "equips": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Equip"
      },
      "title": "Equips",
      "type": "array"
    },
    "feeds": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Feed"
      },
      "title": "Feeds",
      "type": "array"
    },
    "buses": {
      "default": [],
      "items": {
        "discriminator": {
          "mapping": {
            "modbus_rtu": "#/$defs/ModbusRtuBus",
            "modbus_rtu_over_tcp": "#/$defs/ModbusRtuOverTcpBus",
            "modbus_tcp_gateway": "#/$defs/ModbusTcpGatewayBus"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ModbusRtuBus"
          },
          {
            "$ref": "#/$defs/ModbusRtuOverTcpBus"
          },
          {
            "$ref": "#/$defs/ModbusTcpGatewayBus"
          }
        ]
