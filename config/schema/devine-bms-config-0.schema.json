{
  "$defs": {
    "ByteOrder": {
      "enum": [
        "big",
        "little"
      ],
      "title": "ByteOrder",
      "type": "string"
    },
    "DataType": {
      "enum": [
        "bit",
        "int16",
        "uint16",
        "int32",
        "uint32",
        "float32"
      ],
      "title": "DataType",
      "type": "string"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "modbus_tcp",
            "modbus"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModbusTcpConnection"
            },
            {
              "$ref": "#/$defs/ModbusBusConnection"
            }
          ],
          "title": "Connection"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dis",
        "protocol",
        "connection"
      ],
      "title": "Device",
      "type": "object"
    },
    "Equip": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "space": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "tags": {
          "default": {},
          "patternProperties": {
            "^[a-z][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "title": "Tags",
          "type": "object"
        }
      },
      "required": [
        "name",
        "dis"
      ],
      "title": "Equip",
      "type": "object"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "To",
          "type": "string"
        },
        "medium": {
          "$ref": "#/$defs/Medium"
        }
      },
      "required": [
        "from",
        "to",
        "medium"
      ],
      "title": "Feed",
      "type": "object"
    },
    "GeoCoord": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "GeoCoord",
      "type": "object"
    },
    "Kind": {
      "enum": [
        "Number",
        "Bool",
        "Str"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Medium": {
      "enum": [
        "air",
        "chilledWater",
        "hotWater",
        "condenserWater",
        "elec",
        "refrig"
      ],
      "title": "Medium",
      "type": "string"
    },
    "ModbusAddress": {
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "$ref": "#/$defs/ObjectType"
        },
        "address": {
          "description": "Wire address (0-based)",
          "maximum": 65535,
          "minimum": 0,
          "title": "Address",
          "type": "integer"
        },
        "dataType": {
          "$ref": "#/$defs/DataType"
        },
        "byteOrder": {
          "$ref": "#/$defs/ByteOrder",
          "default": "big"
        },
        "wordOrder": {
          "$ref": "#/$defs/WordOrder",
          "default": "high_first"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "title": "Offset",
          "type": "number"
        }
      },
      "required": [
        "objectType",
        "address",
        "dataType"
      ],
      "title": "ModbusAddress",
      "type": "object"
    },
    "ModbusBusConnection": {
      "additionalProperties": false,
      "description": "A device on a bus: its unit (slave) ID and how many registers it reads at once.",
      "properties": {
        "bus": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Bus",
          "type": "string"
        },
        "unitId": {
          "maximum": 247,
          "minimum": 1,
          "title": "Unitid",
          "type": "integer"
        },
        "blockSize": {
          "default": 32,
          "maximum": 125,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        }
      },
      "required": [
        "bus",
        "unitId"
      ],
      "title": "ModbusBusConnection",
      "type": "object"
    },
    "ModbusRtuBus": {
      "additionalProperties": false,
      "description": "An RS485 line on a serial port (main spec 5.1). One adapter and port per bus, never shared.",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_rtu",
          "title": "Type",
          "type": "string"
        },
        "port": {
          "minLength": 1,
          "title": "Port",
          "type": "string"
        },
        "baudrate": {
          "default": 9600,
          "maximum": 115200,
          "minimum": 1200,
          "title": "Baudrate",
          "type": "integer"
        },
        "parity": {
          "default": "N",
          "enum": [
            "N",
            "E",
            "O"
          ],
          "title": "Parity",
          "type": "string"
        },
        "dataBits": {
          "default": 8,
          "enum": [
            7,
            8
          ],
          "title": "Databits",
          "type": "integer"
        },
        "stopBits": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Stopbits",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "port"
      ],
      "title": "ModbusRtuBus",
      "type": "object"
    },
    "ModbusRtuOverTcpBus": {
      "additionalProperties": false,
      "description": "A serial-to-Ethernet gateway that passes raw RTU frames over TCP (main spec 5.1).",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_rtu_over_tcp",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "host"
      ],
      "title": "ModbusRtuOverTcpBus",
      "type": "object"
    },
    "ModbusTcpConnection": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "unitId": {
          "default": 1,
          "maximum": 255,
          "minimum": 0,
          "title": "Unitid",
          "type": "integer"
        },
        "timeoutS": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "blockSize": {
          "default": 32,
          "maximum": 125,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "ModbusTcpConnection",
      "type": "object"
    },
    "ModbusTcpGatewayBus": {
      "additionalProperties": false,
      "description": "A serial-to-Ethernet gateway that converts Modbus TCP to RTU, addressing devices by unit ID.",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_tcp_gateway",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "host"
      ],
      "title": "ModbusTcpGatewayBus",
      "type": "object"
    },
    "ObjectType": {
      "enum": [
        "coil",
        "discreteInput",
        "holdingRegister",
        "inputRegister"
      ],
      "title": "ObjectType",
      "type": "string"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
