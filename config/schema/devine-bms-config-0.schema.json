{
  "$defs": {
    "BacnetAddress": {
      "additionalProperties": false,
      "description": "A BACnet object and property. Multi-state values are 1-based: state 1 is enum[0].",
      "properties": {
        "objectType": {
          "$ref": "#/$defs/BacnetObjectType"
        },
        "instance": {
          "maximum": 4194302,
          "minimum": 0,
          "title": "Instance",
          "type": "integer"
        },
        "property": {
          "const": "presentValue",
          "default": "presentValue",
          "title": "Property",
          "type": "string"
        }
      },
      "required": [
        "objectType",
        "instance"
      ],
      "title": "BacnetAddress",
      "type": "object"
    },
    "BacnetIpConnection": {
      "additionalProperties": false,
      "description": "A BACnet/IP device (main spec 5.1, milestone 4b).",
      "properties": {
        "address": {
          "pattern": "^[0-9.]+(:[0-9]{1,5})?$",
          "title": "Address",
          "type": "string"
        },
        "deviceInstance": {
          "maximum": 4194302,
          "minimum": 0,
          "title": "Deviceinstance",
          "type": "integer"
        },
        "timeoutS": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "blockSize": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        },
        "cov": {
          "default": false,
          "title": "Cov",
          "type": "boolean"
        },
        "covLifetimeS": {
          "default": 300,
          "maximum": 86400,
          "minimum": 60,
          "title": "Covlifetimes",
          "type": "integer"
        }
      },
      "required": [
        "address",
        "deviceInstance"
      ],
      "title": "BacnetIpConnection",
      "type": "object"
    },
    "BacnetMstpConnection": {
      "additionalProperties": false,
      "description": "A BACnet MS/TP device on a trunk (milestone 4c).",
      "properties": {
        "trunk": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Trunk",
          "type": "string"
        },
        "mac": {
          "maximum": 127,
          "minimum": 2,
          "title": "Mac",
          "type": "integer"
        },
        "deviceInstance": {
          "maximum": 4194302,
          "minimum": 0,
          "title": "Deviceinstance",
          "type": "integer"
        },
        "blockSize": {
          "default": 10,
          "maximum": 50,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        }
      },
      "required": [
        "trunk",
        "mac",
        "deviceInstance"
      ],
      "title": "BacnetMstpConnection",
      "type": "object"
    },
    "BacnetMstpTrunk": {
      "additionalProperties": false,
      "description": "A BACnet MS/TP trunk, run by the bms-mstp service on the host (main spec 5.1, 9, 11; milestone 4c).\n\nThe service owns the serial port and is the MS/TP master node; the backend reads devices\nthrough its local API. The port and MS/TP settings here must match the service's settings\n(`mstp/` in the repository); the commissioning check compares them.",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 8.0,
          "exclusiveMinimum": 0,
          "maximum": 120,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "bacnet_mstp",
          "title": "Type",
          "type": "string"
        },
        "service": {
          "pattern": "^[0-9.]+:[0-9]{1,5}$",
          "title": "Service",
          "type": "string"
        },
        "port": {
          "description": "Serial port the service uses",
          "minLength": 1,
          "title": "Port",
          "type": "string"
        },
        "baudrate": {
          "default": 38400,
          "enum": [
            9600,
            19200,
            38400,
            57600,
            76800,
            115200
          ],
          "title": "Baudrate",
          "type": "integer"
        },
        "mac": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Mac",
          "type": "integer"
        },
        "maxMaster": {
          "default": 127,
          "maximum": 127,
          "minimum": 1,
          "title": "Maxmaster",
          "type": "integer"
        },
        "maxInfoFrames": {
          "default": 1,
          "maximum": 255,
          "minimum": 1,
          "title": "Maxinfoframes",
          "type": "integer"
        },
        "deviceInstance": {
          "description": "The service node's own instance",
          "maximum": 4194302,
          "minimum": 0,
          "title": "Deviceinstance",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "service",
        "port",
        "deviceInstance"
      ],
      "title": "BacnetMstpTrunk",
      "type": "object"
    },
    "BacnetObjectType": {
      "enum": [
        "analogInput",
        "analogOutput",
        "analogValue",
        "binaryInput",
        "binaryOutput",
        "binaryValue",
        "multiStateInput",
        "multiStateOutput",
        "multiStateValue"
      ],
      "title": "BacnetObjectType",
      "type": "string"
    },
    "BacnetSettings": {
      "additionalProperties": false,
      "description": "The BMS's own BACnet/IP identity on the device network (main spec 5.1, 5.11).",
      "properties": {
        "localAddress": {
          "pattern": "^[0-9.]+/[0-9]{1,2}$",
          "title": "Localaddress",
          "type": "string"
        },
        "port": {
          "default": 47808,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "deviceInstance": {
          "maximum": 4194302,
          "minimum": 0,
          "title": "Deviceinstance",
          "type": "integer"
        },
        "deviceName": {
          "default": "Devine BMS",
          "title": "Devicename",
          "type": "string"
        }
      },
      "required": [
        "localAddress",
        "deviceInstance"
      ],
      "title": "BacnetSettings",
      "type": "object"
    },
    "ByteOrder": {
      "enum": [
        "big",
        "little"
      ],
      "title": "ByteOrder",
      "type": "string"
    },
    "DataType": {
      "enum": [
        "bit",
        "int16",
        "uint16",
        "int32",
        "uint32",
        "float32"
      ],
      "title": "DataType",
      "type": "string"
    },
    "Device": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "modbus_tcp",
            "modbus",
            "bacnet_ip",
            "bacnet_mstp",
            "mqtt"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "connection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModbusTcpConnection"
            },
            {
              "$ref": "#/$defs/ModbusBusConnection"
            },
            {
              "$ref": "#/$defs/BacnetIpConnection"
            },
            {
              "$ref": "#/$defs/BacnetMstpConnection"
            },
            {
              "$ref": "#/$defs/MqttConnection"
            }
          ],
          "title": "Connection"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dis",
        "protocol",
        "connection"
      ],
      "title": "Device",
      "type": "object"
    },
    "Equip": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "space": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Space"
        },
        "parent": {
          "anyOf": [
            {
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "tags": {
          "default": {},
          "patternProperties": {
            "^[a-z][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "title": "Tags",
          "type": "object"
        },
        "template": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateLink"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "dis"
      ],
      "title": "Equip",
      "type": "object"
    },
    "EquipTemplate": {
      "additionalProperties": false,
      "description": "An equipment or room template (main spec 5.1.2). Each version is a separate entry.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "appliesTo": {
          "default": "equip",
          "enum": [
            "equip",
            "space"
          ],
          "title": "Appliesto",
          "type": "string"
        },
        "tags": {
          "default": {},
          "patternProperties": {
            "^[a-z][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "title": "Tags",
          "type": "object"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/TemplateRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "parameters": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "default": {},
          "title": "Parameters",
          "type": "object"
        },
        "graphic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Graphic"
        },
        "logic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logic"
        },
        "notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "id",
        "version",
        "dis",
        "roles"
      ],
      "title": "EquipTemplate",
      "type": "object"
    },
    "Feed": {
      "additionalProperties": false,
      "properties": {
        "from": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "From",
          "type": "string"
        },
        "to": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "To",
          "type": "string"
        },
        "medium": {
          "$ref": "#/$defs/Medium"
        }
      },
      "required": [
        "from",
        "to",
        "medium"
      ],
      "title": "Feed",
      "type": "object"
    },
    "GeoCoord": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ],
      "title": "GeoCoord",
      "type": "object"
    },
    "Kind": {
      "enum": [
        "Number",
        "Bool",
        "Str"
      ],
      "title": "Kind",
      "type": "string"
    },
    "Medium": {
      "enum": [
        "air",
        "chilledWater",
        "hotWater",
        "condenserWater",
        "elec",
        "refrig"
      ],
      "title": "Medium",
      "type": "string"
    },
    "ModbusAddress": {
      "additionalProperties": false,
      "properties": {
        "objectType": {
          "$ref": "#/$defs/ObjectType"
        },
        "address": {
          "description": "Wire address (0-based)",
          "maximum": 65535,
          "minimum": 0,
          "title": "Address",
          "type": "integer"
        },
        "dataType": {
          "$ref": "#/$defs/DataType"
        },
        "byteOrder": {
          "$ref": "#/$defs/ByteOrder",
          "default": "big"
        },
        "wordOrder": {
          "$ref": "#/$defs/WordOrder",
          "default": "high_first"
        },
        "scale": {
          "default": 1.0,
          "title": "Scale",
          "type": "number"
        },
        "offset": {
          "default": 0.0,
          "title": "Offset",
          "type": "number"
        }
      },
      "required": [
        "objectType",
        "address",
        "dataType"
      ],
      "title": "ModbusAddress",
      "type": "object"
    },
    "ModbusBusConnection": {
      "additionalProperties": false,
      "description": "A device on a bus: its unit (slave) ID and how many registers it reads at once.",
      "properties": {
        "bus": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Bus",
          "type": "string"
        },
        "unitId": {
          "maximum": 247,
          "minimum": 1,
          "title": "Unitid",
          "type": "integer"
        },
        "blockSize": {
          "default": 32,
          "maximum": 125,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        }
      },
      "required": [
        "bus",
        "unitId"
      ],
      "title": "ModbusBusConnection",
      "type": "object"
    },
    "ModbusRtuBus": {
      "additionalProperties": false,
      "description": "An RS485 line on a serial port (main spec 5.1). One adapter and port per bus, never shared.",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_rtu",
          "title": "Type",
          "type": "string"
        },
        "port": {
          "minLength": 1,
          "title": "Port",
          "type": "string"
        },
        "baudrate": {
          "default": 9600,
          "maximum": 115200,
          "minimum": 1200,
          "title": "Baudrate",
          "type": "integer"
        },
        "parity": {
          "default": "N",
          "enum": [
            "N",
            "E",
            "O"
          ],
          "title": "Parity",
          "type": "string"
        },
        "dataBits": {
          "default": 8,
          "enum": [
            7,
            8
          ],
          "title": "Databits",
          "type": "integer"
        },
        "stopBits": {
          "default": 1,
          "enum": [
            1,
            2
          ],
          "title": "Stopbits",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "port"
      ],
      "title": "ModbusRtuBus",
      "type": "object"
    },
    "ModbusRtuOverTcpBus": {
      "additionalProperties": false,
      "description": "A serial-to-Ethernet gateway that passes raw RTU frames over TCP (main spec 5.1).",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_rtu_over_tcp",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "host"
      ],
      "title": "ModbusRtuOverTcpBus",
      "type": "object"
    },
    "ModbusTcpConnection": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "unitId": {
          "default": 1,
          "maximum": 255,
          "minimum": 0,
          "title": "Unitid",
          "type": "integer"
        },
        "timeoutS": {
          "default": 3.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 2,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "blockSize": {
          "default": 32,
          "maximum": 125,
          "minimum": 1,
          "title": "Blocksize",
          "type": "integer"
        }
      },
      "required": [
        "host"
      ],
      "title": "ModbusTcpConnection",
      "type": "object"
    },
    "ModbusTcpGatewayBus": {
      "additionalProperties": false,
      "description": "A serial-to-Ethernet gateway that converts Modbus TCP to RTU, addressing devices by unit ID.",
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "timeoutS": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 60,
          "title": "Timeouts",
          "type": "number"
        },
        "retries": {
          "default": 1,
          "maximum": 10,
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "type": {
          "const": "modbus_tcp_gateway",
          "title": "Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 502,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "dis",
        "type",
        "host"
      ],
      "title": "ModbusTcpGatewayBus",
      "type": "object"
    },
    "MqttAddress": {
      "additionalProperties": false,
      "description": "Where an MQTT point's value comes from (milestone 4d).\n\nPlain: the whole payload is the value, for example `21.5`, `ON` or `true`.\nJSON: `json_path` picks a field with dots between names, for example `ENERGY.Power`\n(Tasmota), `temperature` (Zigbee2MQTT) or `apower` (Shelly Gen2). A number in the path\npicks a list entry, for example `channels.0.value`.",
      "properties": {
        "topic": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        },
        "jsonPath": {
          "anyOf": [
            {
              "pattern": "^[^.\\s]+(\\.[^.\\s]+)*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Jsonpath"
        },
        "trueValues": {
          "default": [
            "on",
            "true",
            "1",
            "yes",
            "online",
            "open",
            "active"
          ],
          "items": {
            "type": "string"
          },
          "title": "Truevalues",
          "type": "array"
        },
        "falseValues": {
          "default": [
            "off",
            "false",
            "0",
            "no",
            "offline",
            "closed",
            "inactive"
          ],
          "items": {
            "type": "string"
          },
          "title": "Falsevalues",
          "type": "array"
        }
      },
      "required": [
        "topic"
      ],
