    "Space": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "dis": {
          "title": "Dis",
          "type": "string"
        },
        "tags": {
          "default": {},
          "patternProperties": {
            "^[a-z][A-Za-z0-9_]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
