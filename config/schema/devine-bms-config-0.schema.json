        "staleAfterS": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Staleafters"
        },
        "his": {
          "default": true,
          "title": "His",
          "type": "boolean"
        }
